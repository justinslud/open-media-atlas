# Local development. Never use these values in production.
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me-for-any-shared-environment
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated HTTPS origins when running behind a public proxy.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://catalog.example.org
# PostgreSQL is the production/default target. Omit locally to use db.sqlite3.
# DATABASE_URL=postgresql://oma:oma@localhost:5432/oma
